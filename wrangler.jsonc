// Cloudflare Worker for hot.emb500.de: static pages in ./public, plus the device counter of the
// company version (src/worker.js, only for /api/*; KV namespace "hot-fleet") and the FAQ assistant
// (src/ask.js, /api/ask: Workers AI, rate limit 10 questions per minute and IP).
// Logs and traces are off on purpose: the privacy policy promises no request logging.
{
  "name": "hot-rechner",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "ai": { "binding": "AI" },
  "ratelimits": [
    { "name": "ASK_LIMIT", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } }
  ],
  "kv_namespaces": [
    { "binding": "FLEET", "id": "7b3f71439fc741d3b085777533817137" }
  ],
  // Problem reports (src/report.js): manufacturer address and sender. Secret BREVO_API_KEY is set in the
  // Cloudflare dashboard (Workers → hot-rechner → Settings → Variables and Secrets), never in this file.
  "vars": {
    "REPORT_TO": "info@emb500.de",
    "REPORT_FROM": "meldungen@emb500.de"
  },
  // 1st of every month, 06:00 UTC: "Meldesystem läuft" mail to REPORT_TO (keeps the Brevo key alive, tests delivery)
  "triggers": { "crons": ["0 6 1 * *"] },
  "workers_dev": true,
  "observability": { "enabled": false },
  "previews": {
    "observability": { "enabled": false }
  }
}
